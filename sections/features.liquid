{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.features.eyebrow' | t
  endif
  assign heading = s.heading
  if heading == blank
    assign heading = 'sections.features.heading' | t
  endif
-%}
<section class="section{% if s.background == 'alt' %} section--alt{% endif %}" aria-labelledby="Features-{{ section.id }}">
  <div class="page-width">
    <div class="section-intro section-intro--center">
      <p class="eyebrow" data-reveal>{{ eyebrow }}</p>
      <h2 class="h1" id="Features-{{ section.id }}" data-reveal>{{ heading }}</h2>
    </div>
    <ul class="features" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign key = block.settings.feature
          assign title = block.settings.title
          if title == blank
            assign title_key = 'sections.features.' | append: key | append: '_title'
            assign title = title_key | t
          endif
          assign body = block.settings.text
          if body == blank
            assign body_key = 'sections.features.' | append: key | append: '_text'
            assign body = body_key | t
          endif
          case key
            when 'envelope'
              assign icon = 'seal'
            when 'rsvp'
              assign icon = 'message'
            when 'countdown'
              assign icon = 'clock'
            when 'map'
              assign icon = 'pin'
            when 'programme'
              assign icon = 'list'
            when 'music'
              assign icon = 'music'
            when 'bilingual'
              assign icon = 'language'
            else
              assign icon = 'share'
          endcase
        -%}
        <li class="feature" data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 0.07 }}s" {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: icon, size: 22 %}</span>
          <h3 class="feature__title">{{ title }}</h3>
          <p class="feature__text">{{ body }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "placeholder": "In every invitation" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Cream" },
        { "value": "alt", "label": "Deeper cream" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "feature",
          "label": "Feature",
          "options": [
            { "value": "envelope", "label": "Envelope opening" },
            { "value": "rsvp", "label": "RSVP" },
            { "value": "countdown", "label": "Countdown" },
            { "value": "map", "label": "Directions & calendar" },
            { "value": "programme", "label": "Programme" },
            { "value": "music", "label": "Music" },
            { "value": "bilingual", "label": "Bilingual" },
            { "value": "share", "label": "Share-ready" }
          ],
          "default": "envelope",
          "info": "Sets the icon and default wording."
        },
        { "type": "text", "id": "title", "label": "Title (optional override)" },
        { "type": "textarea", "id": "text", "label": "Text (optional override)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "feature": "envelope" } },
        { "type": "feature", "settings": { "feature": "rsvp" } },
        { "type": "feature", "settings": { "feature": "countdown" } },
        { "type": "feature", "settings": { "feature": "map" } }
      ]
    }
  ]
}
{% endschema %}
