<section class="section">
  <div class="page-width">
    <div class="section-intro"><p class="eyebrow eyebrow--rule">{{ shop.name }}</p><h1 class="h1">{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="product-grid" style="--cols: 3">
        {%- for article in blog.articles -%}
          <article class="card">
            {%- if article.image -%}
              <a class="card__media" href="{{ article.url }}" style="aspect-ratio: 4/3">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}</a>
            {%- endif -%}
            <p class="card__meta">{{ article.published_at | date: '%B %-d, %Y' }}</p>
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__meta">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            <a class="link-arrow" href="{{ article.url }}">{{ 'blogs.read_more' | t }}</a>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Journal", "tag": "div", "settings": [] }
{% endschema %}
