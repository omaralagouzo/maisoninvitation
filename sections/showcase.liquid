{%- comment -%}
  Language-based product showcase.

  The English / العربية tabs browse *example invitations* in each language — they do
  NOT change the website language (that's the globe menu in the header). Each tab
  shows every design using the variant whose option value matches the tab (e.g. the
  "Arabic" variant), so cards show real Arabic previews, prices and links.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign coll = s.collection
  if coll == blank
    assign coll = collections['invitations']
  endif
  if coll == blank or coll.products_count == 0
    assign coll = collections['all']
  endif

  assign eyebrow = s.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.showcase.eyebrow' | t
  endif
  assign heading = s.heading
  if heading == blank
    assign heading = 'sections.showcase.heading' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'sections.showcase.text' | t
  endif

  assign selected_id = section.blocks.first.id
  for block in section.blocks
    if block.settings.language_code == request.locale.iso_code
      assign selected_id = block.id
    endif
  endfor
-%}

{%- comment -%} Initially selected tab: the one matching the site language, else the first. {%- endcomment -%}
<tab-switcher class="section showcase" id="Showcase-{{ section.id }}">
  <div class="page-width">
    <div class="section-intro section-intro--split">
      <div>
        <p class="eyebrow eyebrow--rule" data-reveal>{{ eyebrow }}</p>
        <h2 class="h1" data-reveal>{{ heading }}</h2>
        <p class="lede" data-reveal>{{ text }}</p>
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="showcase__tabs-wrap" data-reveal>
          <span class="showcase__tabs-label" id="ShowcaseTabsLabel-{{ section.id }}">{{ 'sections.showcase.tabs_label' | t }}</span>
          <div class="tabs" role="tablist" aria-labelledby="ShowcaseTabsLabel-{{ section.id }}">
            <span class="tabs__indicator" aria-hidden="true"></span>
            {%- for block in section.blocks -%}
              {%- liquid
                assign label = block.settings.label
                if label == blank
                  assign label = 'sections.showcase.tab_' | append: block.settings.language_code | t
                endif
              -%}
              <button
                type="button"
                class="tabs__tab"
                role="tab"
                id="Tab-{{ block.id }}"
                aria-controls="Panel-{{ block.id }}"
                aria-selected="{% if block.id == selected_id %}true{% else %}false{% endif %}"
                tabindex="{% if block.id == selected_id %}0{% else %}-1{% endif %}"
                lang="{{ block.settings.language_code }}"
                {{ block.shopify_attributes }}
              >
                {{ label }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="tab-panel"
        role="tabpanel"
        id="Panel-{{ block.id }}"
        aria-labelledby="Tab-{{ block.id }}"
        tabindex="0"
        {% unless block.id == selected_id %}hidden{% endunless %}
      >
        <div class="product-grid">
          {%- for product in coll.products limit: s.limit -%}
            {%- comment -%}
              Match by SKU suffix first (IVOIRE-EN / IVOIRE-AR — never translated),
              then by option value (e.g. "Arabic") as a fallback.
            {%- endcomment -%}
            {%- liquid
              assign match = nil
              assign sku_tail = '-' | append: block.settings.language_code | upcase
              for v in product.variants
                assign tail = v.sku | upcase | slice: -3, 3
                if tail == sku_tail or v.options contains block.settings.option_value
                  assign match = v
                  break
                endif
              endfor
            -%}
            {% render 'product-card', product: product, variant: match, lang: block.settings.language_code, index: forloop.index0, eager: false %}
          {%- else -%}
            <p class="muted">{{ 'collections.empty' | t }}</p>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    <div class="showcase__footer" data-reveal>
      <p class="showcase__note">{% render 'icon', name: 'language', size: 22 %}{{ 'sections.showcase.bilingual_note' | t }}</p>
      <a class="btn btn--outline" href="{{ coll.url }}">{{ 'sections.showcase.view_all' | t }} {% render 'icon', name: 'arrow', size: 18 %}</a>
    </div>
  </div>
</tab-switcher>

{% schema %}
{
  "name": "Invitation showcase",
  "tag": "section",
  "class": "section-showcase",
  "settings": [
    {
      "type": "paragraph",
      "content": "These tabs browse example invitations by language. They don't change the website language (that's the globe in the header)."
    },
    { "type": "text", "id": "eyebrow", "label": "Small label", "placeholder": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "placeholder": "Choose your invitation" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to “invitations”." },
    { "type": "range", "id": "limit", "min": 2, "max": 16, "step": 1, "label": "Designs per tab", "default": 8 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Language tab",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Leave blank for “English” / “العربية”." },
        {
          "type": "select",
          "id": "language_code",
          "label": "Invitation language",
          "options": [
            { "value": "en", "label": "English" },
            { "value": "ar", "label": "Arabic" }
          ],
          "default": "en"
        },
        {
          "type": "text",
          "id": "option_value",
          "label": "Variant option value",
          "default": "English",
          "info": "Cards use the variant whose option matches this exactly (e.g. English, Arabic)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Invitation showcase",
      "blocks": [
        { "type": "tab", "settings": { "language_code": "en", "option_value": "English" } },
        { "type": "tab", "settings": { "language_code": "ar", "option_value": "Arabic" } }
      ]
    }
  ]
}
{% endschema %}
