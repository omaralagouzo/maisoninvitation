{%- comment -%}
  Cart page. Invitation details are line item properties (English keys, e.g.
  "Wedding date"); they're shown here with translated labels. Keys starting with "_"
  are hidden, following Shopify convention.
{%- endcomment -%}
{%- liquid
  assign coll = collections['invitations']
  if coll == blank
    assign coll = collections['all']
  endif
-%}
<div class="page-width" style="padding-block: clamp(40px, 6vw, 88px) var(--section-space)">
  <div class="section-intro">
    <p class="eyebrow eyebrow--rule">{{ 'header.cart' | t }}</p>
    <h1 class="h1">{{ 'cart.title' | t }}</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <span class="empty-state__mark">{% render 'brand-logo', variant: 'mark' %}</span>
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <p class="muted">{{ 'cart.empty_text' | t }}</p>
      <a class="btn" href="{{ coll.url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow', size: 18 %}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart">
      <input type="hidden" name="form_type" value="cart">
      <div>
        <div class="cart-items" role="list">
          {%- for item in cart.items -%}
            <div class="cart-item" role="listitem">
              <a class="cart-item__media" href="{{ item.url }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, sizes: '110px' }}
                {%- else -%}
                  <span style="display:grid;place-items:center;width:100%;height:100%;color:var(--color-accent);padding:24%">{% render 'brand-logo', variant: 'mark' %}</span>
                {%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">
                    {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
                  </p>
                {%- endunless -%}
                {%- if item.properties.size > 0 -%}
                  <dl class="cart-item__props">
                    {%- for p in item.properties -%}
                      {%- assign first_char = p.first | slice: 0 -%}
                      {%- if p.last == blank or first_char == '_' -%}{%- continue -%}{%- endif -%}
                      {%- case p.first -%}
                        {%- when 'Name 1' -%}{%- assign label = 'products.product.field_name_one' | t -%}
                        {%- when 'Name 2' -%}{%- assign label = 'products.product.field_name_two' | t -%}
                        {%- when 'Names in Arabic' -%}{%- assign label = 'products.product.field_names_ar' | t -%}
                        {%- when 'Wedding date' -%}{%- assign label = 'products.product.field_date' | t -%}
                        {%- when 'Start time' -%}{%- assign label = 'products.product.field_time' | t -%}
                        {%- when 'Venue' -%}{%- assign label = 'products.product.field_venue' | t -%}
                        {%- when 'City' -%}{%- assign label = 'products.product.field_city' | t -%}
                        {%- when 'RSVP by' -%}{%- assign label = 'products.product.field_rsvp_by' | t -%}
                        {%- when 'RSVP method' -%}{%- assign label = 'cart.rsvp_method' | t -%}
                        {%- when 'RSVP WhatsApp' -%}{%- assign label = 'products.product.field_whatsapp' | t -%}
                        {%- when 'Notes' -%}{%- assign label = 'products.product.field_notes' | t -%}
                        {%- else -%}{%- assign label = p.first -%}
                      {%- endcase -%}
                      <div><dt>{{ label }}:</dt><dd dir="auto">{{ p.last | escape | truncate: 140 }}</dd></div>
                    {%- endfor -%}
                  </dl>
                {%- endif -%}
                <a class="cart-item__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0">{{ 'cart.remove' | t }}</a>
              </div>
              <div class="cart-item__price">
                {% render 'money', amount: item.final_line_price %}
                {%- if item.quantity > 1 -%}<div class="muted" style="font-size:.85rem">× {{ item.quantity }}</div>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        <div class="field" style="margin-block-start: 32px">
          <label class="field__label" for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" rows="3" placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
        </div>
      </div>

      <aside class="cart-summary">
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{% render 'money', amount: cart.total_price %}</strong>
        </div>
        <p class="cart-summary__note">{{ 'cart.taxes' | t }}</p>
        <p class="reassurance">{% render 'icon', name: 'envelope', size: 16 %}{{ 'cart.digital_note' | t }}</p>
        <button type="submit" name="checkout" class="btn btn--block">{{ 'cart.checkout' | t }} {% render 'icon', name: 'lock', size: 16 %}</button>
        {%- if additional_checkout_buttons -%}
          <div class="cart-summary__express">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <p class="cart-summary__secure">{% render 'icon', name: 'lock', size: 14 %}{{ 'cart.secure' | t }}</p>
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
