<section class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width page-width--narrow" style="text-align: {{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h1" style="margin-block-end: 24px">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte lede" style="margin-inline: auto">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p style="margin-block-start: 32px"><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Alignment",
      "options": [{ "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }],
      "default": "center"
    },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [{ "value": "default", "label": "Cream" }, { "value": "alt", "label": "Deeper cream" }],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
