{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'sections.about.heading' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'sections.about.text_html' | t
  endif
-%}
<section class="section" style="padding-block-start: 0">
  <div class="page-width">
    <div class="split">
      <div class="split__media split__media--arch" data-reveal>
        {%- if s.image -%}
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw' }}
        {%- else -%}
          <div style="display:grid;place-items:center;gap:28px;padding:18%;width:100%;height:100%;background:var(--color-bg-alt)">
            <img class="split__seal" src="{{ 'brand-seal.svg' | asset_url }}" alt="" width="220" height="220">
          </div>
        {%- endif -%}
      </div>
      <div class="split__content">
        <p class="eyebrow eyebrow--rule" data-reveal>{{ 'sections.page_hero.about_eyebrow' | t }}</p>
        <h2 class="h1" data-reveal>{{ heading }}</h2>
        <div class="rte lede" data-reveal>{{ text }}</div>
      </div>
    </div>

    <div class="values">
      {%- for i in (1..3) -%}
        {%- assign tkey = 'sections.about.value_' | append: i | append: '_title' -%}
        {%- assign xkey = 'sections.about.value_' | append: i | append: '_text' -%}
        <div class="value" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s">
          <h3 class="value__title">{{ tkey | t }}</h3>
          <p class="value__text">{{ xkey | t }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — story",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "A photo of the two of you, your workspace or your stationery. Defaults to the wax seal." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Story", "info": "Leave blank for the default (translated) story." }
  ],
  "presets": [{ "name": "About — story" }]
}
{% endschema %}
