<section class="password">
  <div class="password__inner">
    <span class="password__logo">{% render 'brand-logo', variant: 'full' %}</span>
    <div class="password__arch" aria-hidden="true"></div>
    <p class="eyebrow">{{ 'sections.hero.eyebrow' | t }}</p>
    <h1 class="display password__heading">{{ 'sections.hero.heading_html' | t }}</h1>
    <p class="lede" style="margin-inline:auto">{{ 'general.password_page.text' | t }}</p>

    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch, newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{% render 'icon', name: 'check', size: 18 %} {{ 'general.password_page.thanks' | t }}</p>
      {%- else -%}
        <div class="field-row" style="grid-template-columns: 1fr auto; align-items: end">
          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{{ 'general.password_page.email' | t }}</label>
            <input id="PasswordEmail" type="email" name="contact[email]" required placeholder="{{ 'general.password_page.email' | t }}" autocomplete="email">
          </div>
          <button type="submit" class="btn">{{ 'general.password_page.notify' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password__owner">
      <summary>{{ 'general.password_page.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field-row" style="grid-template-columns: 1fr auto; align-items: end">
          <div class="field">
            <label class="visually-hidden" for="StorePassword">{{ 'general.password_page.password' | t }}</label>
            <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.password' | t }}">
          </div>
          <button type="submit" class="btn btn--outline">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "tag": "div", "settings": [] }
{% endschema %}
