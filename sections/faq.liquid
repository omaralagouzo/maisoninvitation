{%- liquid
  assign s = section.settings
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign eyebrow = s.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.faq.eyebrow' | t
  endif
  assign heading = s.heading
  if heading == blank
    assign heading = 'sections.faq.heading' | t
  endif
-%}
<section class="section{% if s.background == 'alt' %} section--alt{% endif %}" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width">
    <div class="faq{% if s.layout == 'stacked' %} faq--stacked{% endif %}">
      <div class="faq__intro">
        {%- if s.show_heading -%}
          <p class="eyebrow eyebrow--rule" data-reveal>{{ eyebrow }}</p>
          <h2 class="h1" id="Faq-{{ section.id }}" data-reveal>{{ heading }}</h2>
        {%- endif -%}
        {%- if s.show_contact and s.layout != 'stacked' -%}
          <a class="link-arrow" href="{{ root }}/pages/contact" data-reveal>{{ 'sections.faq.more' | t }} {% render 'icon', name: 'arrow', size: 16 %}</a>
        {%- endif -%}
      </div>
      <div class="accordion" data-reveal>
        {%- for block in section.blocks -%}
          {%- liquid
            assign n = forloop.index
            assign q = block.settings.question
            if q == blank
              assign q_key = 'sections.faq.q' | append: n
              assign q = q_key | t
            endif
            assign a = block.settings.answer
            if a == blank
              assign a_key = 'sections.faq.a' | append: n
              assign a = a_key | t
            endif
          -%}
          <details class="accordion__item" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              <span>{{ q }}</span>
              <span class="accordion__icon" aria-hidden="true"></span>
            </summary>
            <div class="accordion__content rte">
              {%- if a contains '<p' -%}{{ a }}{%- else -%}<p>{{ a }}</p>{%- endif -%}
            </div>
          </details>
        {%- endfor -%}
        {%- if s.show_contact and s.layout == 'stacked' -%}
          <p style="margin-block-start: 36px; text-align: center">
            <a class="link-arrow" href="{{ root }}/pages/contact">{{ 'sections.faq.more' | t }} {% render 'icon', name: 'arrow', size: 16 %}</a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Structured data so answers can appear in search results. {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {%- liquid
          assign n = forloop.index
          assign q = block.settings.question
          if q == blank
            assign q_key = 'sections.faq.q' | append: n
            assign q = q_key | t
          endif
          assign a = block.settings.answer
          if a == blank
            assign a_key = 'sections.faq.a' | append: n
            assign a = a_key | t
          endif
        -%}
        {
          "@type": "Question",
          "name": {{ q | strip_html | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ a | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Questions (FAQ)",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Blank questions use the default wording (translated automatically). Default questions 1–8 cover delivery, timing, edits, RSVP, bilingual, print, music and changes of plan." },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading beside questions" },
        { "value": "stacked", "label": "Heading above questions" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Cream" },
        { "value": "alt", "label": "Deeper cream" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "checkbox", "id": "show_contact", "label": "Show contact link", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions (FAQ)",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
