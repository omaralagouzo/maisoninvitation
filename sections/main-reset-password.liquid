<section class="auth">
  <div class="auth__card">
    <div class="auth__head">
      <span class="auth__mark">{% render 'brand-logo', variant: 'mark' %}</span>
      <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
      <p class="muted">{{ 'customer.reset.text' | t }}</p>
    </div>
    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label class="field__label" for="ResetPass">{{ 'customer.reset.password' | t }}</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="field__label" for="ResetConfirm">{{ 'customer.reset.confirm' | t }}</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--block">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "tag": "div", "settings": [] }
{% endschema %}
