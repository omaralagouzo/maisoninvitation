{%- comment -%}
  On the Arabic storefront the Arabic variant is preselected (unless ?variant= is in the URL).

  Invitation product page with a 3-step wizard:
    1. Language (variant)  2. Details (line item properties)  3. Review + add-ons
  Line item property keys are kept in English on purpose (consistent in Shopify admin
  and exports); the cart shows them translated.
  Works without JavaScript (all steps visible, native validation); product.js adds
  the step-by-step flow, live summary, variant images and add-ons.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  if product.selected_variant == blank and request.locale.iso_code == 'ar'
    for v in product.variants
      assign tail = v.sku | upcase | slice: -3, 3
      if tail == '-AR' and v.available
        assign current_variant = v
        break
      endif
    endfor
  endif
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign coll = collections['invitations']
  if coll == blank
    assign coll = collections['all']
  endif
  assign style_label = product.metafields.maison.style.value | default: product.type
  assign palette = product.metafields.maison.palette.value | split: ','
  assign demo_en = product.metafields.maison.demo_url_en.value
  assign demo_ar = product.metafields.maison.demo_url_ar.value
  assign addons = s.addons
  if addons == blank or addons.size == 0
    assign addons = collections['add-ons'].products
  endif
-%}

<div class="page-width">
  <div class="product" data-product-page>
    {%- comment -%} Gallery {%- endcomment -%}
    <product-gallery class="product__gallery" data-section="{{ section.id }}">
      <div class="gallery__stage">
        {%- for media in product.media -%}
          <div
            class="gallery__slide{% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
          >
            {{ media.preview_image | image_url: width: 1400 | image_tag:
              loading: 'eager',
              sizes: '(min-width: 990px) 55vw, 100vw',
              widths: '600, 900, 1200, 1400',
              alt: media.alt | default: product.title
            }}
          </div>
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <button
              type="button"
              class="gallery__thumb"
              role="listitem"
              data-thumb="{{ media.id }}"
              aria-label="{{ media.alt | default: product.title | escape }}"
              {% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}aria-current="true"{% endif %}
            >
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', sizes: '80px' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-gallery>

    {%- comment -%} Info + wizard {%- endcomment -%}
    <div class="product__info">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        {% render 'icon', name: 'chevron-end', size: 12 %}
        <a href="{{ coll.url }}">{{ 'products.product.breadcrumb' | t }}</a>
        {% render 'icon', name: 'chevron-end', size: 12 %}
        <span aria-current="page">{{ product.title }}</span>
      </nav>

      <header class="product__header">
        {%- if style_label != blank -%}<p class="eyebrow">{{ style_label }}</p>{%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>
        {%- if product.metafields.maison.name_ar != blank -%}
          <p class="product__alt-name" lang="ar">{{ product.metafields.maison.name_ar.value }}</p>
        {%- endif -%}
        {%- if product.metafields.maison.subtitle != blank -%}
          <p class="product__subtitle">{{ product.metafields.maison.subtitle.value }}</p>
        {%- endif -%}
      </header>

      <div class="product__price-row">
        <span class="product__price" data-product-price>
          {%- render 'money', amount: current_variant.price -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s>{% render 'money', amount: current_variant.compare_at_price %}</s>
          {%- endif -%}
        </span>
        <p class="product__tax">{{ 'products.product.tax_note' | t }}</p>
      </div>

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- if palette.size > 1 or demo_en != blank or demo_ar != blank -%}
        <div class="product__meta-row">
          {%- if palette.size > 1 -%}
            <div>
              <span class="product__meta-label">{{ 'products.product.palette' | t }}</span>
              <span class="swatches" style="display:inline-flex">
                {%- for color in palette -%}<span class="swatch" style="background: {{ color | strip }}; width: 18px; height: 18px"></span>{%- endfor -%}
              </span>
            </div>
          {%- endif -%}
          {%- if demo_en != blank or demo_ar != blank -%}
            <div class="product__demos">
              <span class="product__meta-label" style="align-self:center">{{ 'products.product.demos' | t }}</span>
              {%- if demo_en != blank -%}
                <a class="chip-link" href="{{ demo_en }}" target="_blank" rel="noopener">{{ 'products.product.demo_en' | t }} {% render 'icon', name: 'arrow-up-end', size: 14 %}</a>
              {%- endif -%}
              {%- if demo_ar != blank -%}
                <a class="chip-link" href="{{ demo_ar }}" target="_blank" rel="noopener">{{ 'products.product.demo_ar' | t }} {% render 'icon', name: 'arrow-up-end', size: 14 %}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <product-wizard data-cart-url="{{ routes.cart_url }}" data-cart-add="{{ routes.cart_add_url }}">
        {%- form 'product', product, id: 'ProductForm', class: 'wizard' -%}
          <div class="wizard__progress" aria-label="{{ 'products.product.steps_label' | t }}">
            <button type="button" class="wizard__progress-step is-current" data-goto="0"><span class="wizard__num">1</span>{{ 'products.product.step_language' | t }}</button>
            <button type="button" class="wizard__progress-step" data-goto="1"><span class="wizard__num">2</span>{{ 'products.product.step_details' | t }}</button>
            <button type="button" class="wizard__progress-step" data-goto="2"><span class="wizard__num">3</span>{{ 'products.product.step_review' | t }}</button>
          </div>

          {%- comment -%} Step 1 — language (variant) {%- endcomment -%}
          <div class="wizard__step is-current" data-step="0">
            <div class="wizard__step-head">
              <span class="wizard__step-kicker">{{ 'products.product.step' | t: number: 1, total: 3 }}</span>
              <h2 class="wizard__step-title">{{ 'products.product.step_language_heading' | t }}</h2>
            </div>
            <fieldset class="option-cards">
              <legend class="visually-hidden">{{ product.options.first }}</legend>
              {%- for variant in product.variants -%}
                {%- liquid
                  assign code = variant.sku | upcase | split: '-' | last | downcase
                  if code != 'en' and code != 'ar' and code != 'bi'
                    assign code = 'en'
                    if variant.title contains 'Arab' or variant.title contains 'عرب'
                      assign code = 'ar'
                    endif
                    if variant.title contains 'Biling' or variant.title contains 'ثنائي'
                      assign code = 'bi'
                    endif
                  endif
                  case code
                    when 'ar'
                      assign note = 'products.product.language_note_ar' | t
                    when 'bi'
                      assign note = 'products.product.language_note_both' | t
                    else
                      assign note = 'products.product.language_note_en' | t
                  endcase
                -%}
                <label class="option-card">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    data-lang="{{ code }}"
                    data-price="{{ variant.price }}"
                    data-price-label="{% render 'money', amount: variant.price %}"
                    data-media="{{ variant.featured_media.id }}"
                    data-title="{{ variant.title | escape }}"
                    {% if variant.id == current_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span class="option-card__radio" aria-hidden="true"></span>
                  <span class="option-card__label">
                    <span class="option-card__title">{{ variant.title }}</span>
                    <span class="option-card__note">{{ note }}</span>
                  </span>
                  <span class="option-card__price">{% render 'money', amount: variant.price %}</span>
                </label>
              {%- endfor -%}
            </fieldset>
            <div class="wizard__nav wizard__nav--steps">
              <button type="button" class="btn" data-next>{{ 'general.continue' | t }} {% render 'icon', name: 'arrow', size: 18 %}</button>
            </div>
          </div>

          {%- comment -%} Step 2 — details {%- endcomment -%}
          <div class="wizard__step" data-step="1">
            <div class="wizard__step-head">
              <span class="wizard__step-kicker">{{ 'products.product.step' | t: number: 2, total: 3 }}</span>
              <h2 class="wizard__step-title">{{ 'products.product.step_details_heading' | t }}</h2>
              <p class="field__hint">{{ 'products.product.step_details_text' | t }}</p>
            </div>
            <div class="form-stack">
              <div class="field-row">
                <div class="field">
                  <label class="field__label" for="Name1">{{ 'products.product.field_name_one' | t }}</label>
                  <input id="Name1" type="text" name="properties[Name 1]" required autocomplete="off" data-summary="names">
                </div>
                <div class="field">
                  <label class="field__label" for="Name2">{{ 'products.product.field_name_two' | t }}</label>
                  <input id="Name2" type="text" name="properties[Name 2]" required autocomplete="off" data-summary="names">
                </div>
              </div>
              <p class="field__hint" style="margin-top:-10px">{{ 'products.product.field_names_hint' | t }}</p>
              <div class="field" data-when-lang="bi">
                <label class="field__label" for="NamesAr">{{ 'products.product.field_names_ar' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                <input id="NamesAr" type="text" name="properties[Names in Arabic]" dir="rtl" lang="ar" autocomplete="off">
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field__label" for="WeddingDate">{{ 'products.product.field_date' | t }}</label>
                  <input id="WeddingDate" type="date" name="properties[Wedding date]" required data-summary="date">
                </div>
                <div class="field">
                  <label class="field__label" for="StartTime">{{ 'products.product.field_time' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                  <input id="StartTime" type="time" name="properties[Start time]">
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field__label" for="Venue">{{ 'products.product.field_venue' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                  <input id="Venue" type="text" name="properties[Venue]" data-summary="venue">
                </div>
                <div class="field">
                  <label class="field__label" for="City">{{ 'products.product.field_city' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                  <input id="City" type="text" name="properties[City]" data-summary="venue">
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field__label" for="RsvpBy">{{ 'products.product.field_rsvp_by' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                  <input id="RsvpBy" type="date" name="properties[RSVP by]">
                </div>
                <div class="field">
                  <label class="field__label" for="RsvpMethod">{{ 'products.product.field_rsvp_method' | t }}</label>
                  <select id="RsvpMethod" name="properties[RSVP method]" data-rsvp-method>
                    <option value="Online form">{{ 'products.product.rsvp_form' | t }}</option>
                    <option value="WhatsApp">{{ 'products.product.rsvp_whatsapp' | t }}</option>
                    <option value="None">{{ 'products.product.rsvp_none' | t }}</option>
                  </select>
                </div>
              </div>
              <div class="field" data-when-rsvp="WhatsApp" hidden>
                <label class="field__label" for="RsvpWhatsapp">{{ 'products.product.field_whatsapp' | t }}</label>
                <input id="RsvpWhatsapp" type="tel" name="properties[RSVP WhatsApp]" dir="ltr" autocomplete="tel" placeholder="+971 50 000 0000">
              </div>
              <div class="field">
                <label class="field__label" for="Notes">{{ 'products.product.field_notes' | t }} <small>{{ 'products.product.optional' | t }}</small></label>
                <textarea id="Notes" name="properties[Notes]" rows="4" placeholder="{{ 'products.product.field_notes_hint' | t | escape }}"></textarea>
              </div>
            </div>
            <div class="wizard__nav wizard__nav--steps">
              <button type="button" class="wizard__back" data-prev>{% render 'icon', name: 'arrow', size: 16 %} {{ 'general.back' | t }}</button>
              <button type="button" class="btn" data-next>{{ 'general.continue' | t }} {% render 'icon', name: 'arrow', size: 18 %}</button>
            </div>
          </div>

          {%- comment -%} Step 3 — review, add-ons, buy {%- endcomment -%}
          <div class="wizard__step" data-step="2">
            <div class="wizard__step-head">
              <span class="wizard__step-kicker">{{ 'products.product.step' | t: number: 3, total: 3 }}</span>
              <h2 class="wizard__step-title">{{ 'products.product.step_review_heading' | t }}</h2>
            </div>

            <dl class="summary" data-summary-list data-missing="{{ 'products.product.summary_missing' | t | escape }}">
              <div class="summary__row"><dt>{{ 'products.product.summary_design' | t }}</dt><dd>{{ product.title }}</dd></div>
              <div class="summary__row"><dt>{{ 'products.product.summary_language' | t }}</dt><dd data-summary-out="language">{{ current_variant.title }}</dd></div>
              <div class="summary__row"><dt>{{ 'products.product.summary_names' | t }}</dt><dd data-summary-out="names"></dd></div>
              <div class="summary__row"><dt>{{ 'products.product.summary_date' | t }}</dt><dd data-summary-out="date"></dd></div>
              <div class="summary__row"><dt>{{ 'products.product.summary_venue' | t }}</dt><dd data-summary-out="venue"></dd></div>
            </dl>

            {%- if addons.size > 0 -%}
              <div class="addons">
                <p class="field__label">{{ 'products.product.addons_heading' | t }}</p>
                {%- for addon in addons -%}
                  {%- assign av = addon.selected_or_first_available_variant -%}
                  <label class="addon">
                    <input type="checkbox" data-addon="{{ av.id }}" data-price="{{ av.price }}" {% unless av.available %}disabled{% endunless %}>
                    <span>
                      <span class="addon__title">{{ addon.title }}</span>
                      <span class="addon__text">{{ addon.description | strip_html | truncate: 120 }}</span>
                    </span>
                    <span class="addon__price">+{% render 'money', amount: av.price %}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="summary__total">
              <span>{{ 'cart.total' | t }}</span>
              <strong data-summary-total data-money-format="{% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | escape }}{% else %}{{ shop.money_format | escape }}{% endif %}">{% render 'money', amount: current_variant.price %}</strong>
            </div>

            <button type="submit" name="add" class="btn btn--block" data-submit {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
            {%- if s.show_dynamic_checkout -%}
              <div data-payment-button>{{ form | payment_button }}</div>
            {%- endif -%}
            <p class="reassurance">{% render 'icon', name: 'lock', size: 16 %}{{ 'products.product.reassurance' | t }}</p>
            <p class="form-error" data-form-error role="alert" hidden></p>
            <div class="wizard__nav wizard__nav--steps">
              <button type="button" class="wizard__back" data-prev>{% render 'icon', name: 'arrow', size: 16 %} {{ 'general.back' | t }}</button>
            </div>
          </div>
        {%- endform -%}
      </product-wizard>

      <div class="product-extras accordion">
        <details class="accordion__item" open>
          <summary class="accordion__summary"><span>{{ 'products.product.included_heading' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content">
            <ul class="check-list" role="list">
              <li>{% render 'icon', name: 'check', size: 18 %}{{ 'sections.included.i1' | t }}</li>
              <li>{% render 'icon', name: 'check', size: 18 %}{{ 'sections.included.i2' | t }}</li>
              <li>{% render 'icon', name: 'check', size: 18 %}{{ 'sections.included.i3' | t }}</li>
              <li>{% render 'icon', name: 'check', size: 18 %}{{ 'sections.included.i4' | t }}</li>
              <li>{% render 'icon', name: 'check', size: 18 %}{{ 'sections.included.i5' | t }}</li>
            </ul>
          </div>
        </details>
        <details class="accordion__item">
          <summary class="accordion__summary"><span>{{ 'products.product.delivery_heading' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content"><p>{{ 'sections.included.delivery' | t }}</p></div>
        </details>
        <details class="accordion__item">
          <summary class="accordion__summary"><span>{{ 'sections.faq.q5' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content"><p>{{ 'sections.faq.a5' | t }}</p></div>
        </details>
        <details class="accordion__item">
          <summary class="accordion__summary"><span>{{ 'sections.faq.q3' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content"><p>{{ 'sections.faq.a3' | t }}</p></div>
        </details>
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    {%- if product.featured_image -%}
      "image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product — wizard",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "product_list",
      "id": "addons",
      "label": "Add-ons offered in step 3",
      "limit": 4,
      "info": "Defaults to the products in the “add-ons” collection."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show “Buy it now” buttons",
      "default": true,
      "info": "Apple Pay, Shop Pay, etc. Hidden automatically while an add-on is selected."
    }
  ]
}
{% endschema %}
