{%- comment -%}
  Decorative line art for the invitation designs.
  Params: design ('ivoire' | 'minuit' | 'jardin' | 'sable'), part ('crest' | 'divider' | 'corner' | 'horizon')
  Colours follow currentColor; Jardin blossoms use --inv-blush.
  The Jardin sprig is generated by tools/brand/sprig.py.
{%- endcomment -%}
{%- case design -%}
  {%- when 'minuit' -%}
    {%- case part -%}
      {%- when 'crest' -%}
        <svg class="inv-orn inv-orn--crest" viewBox="0 0 160 110" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M92 18a38 38 0 1 0 30 62 32 32 0 1 1-30-62Z" fill="currentColor" fill-opacity=".12"/>
          </g>
          <g fill="currentColor">
            <path d="M40 22l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/>
            <path d="M128 30l1.4 4.2 4.2 1.4-4.2 1.4-1.4 4.2-1.4-4.2-4.2-1.4 4.2-1.4z"/>
            <path d="M24 70l1.2 3.6 3.6 1.2-3.6 1.2-1.2 3.6-1.2-3.6-3.6-1.2 3.6-1.2z"/>
            <path d="M140 84l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/>
            <circle cx="58" cy="12" r="1.2"/><circle cx="112" cy="8" r="1"/><circle cx="150" cy="56" r="1.1"/><circle cx="12" cy="44" r="1"/>
          </g>
        </svg>
      {%- when 'corner' -%}
        <svg class="inv-orn inv-orn--corner" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1"><path d="M2 40V2h38"/><path d="M8 40V8h32"/></g>
          <path d="M2 2l5 5" stroke="currentColor"/><circle cx="8" cy="8" r="2.2" fill="currentColor"/>
        </svg>
      {%- else -%}
        <svg class="inv-orn inv-orn--divider" viewBox="0 0 220 24" aria-hidden="true" focusable="false">
          <path d="M0 12h92M128 12h92" stroke="currentColor" stroke-width="1"/>
          <path d="M110 2l2.6 7.4L120 12l-7.4 2.6L110 22l-2.6-7.4L100 12l7.4-2.6z" fill="currentColor"/>
        </svg>
    {%- endcase -%}

  {%- when 'jardin' -%}
    {%- case part -%}
      {%- when 'crest', 'corner' -%}
        <svg class="inv-orn inv-orn--sprig" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M10 190 Q70 70 190 12"/><path d="M22.6 166.6 Q38.6 172.1 54.3 159.9 Q35.1 155.2 22.6 166.6 Z"/><path d="M37.3 143.1 Q42.0 127.7 29.9 113.3 Q25.9 131.7 37.3 143.1 Z"/><path d="M53.4 121.1 Q66.9 128.0 82.3 119.1 Q65.8 112.3 53.4 121.1 Z"/><path d="M70.8 100.4 Q77.0 87.4 68.0 73.2 Q62.0 88.9 70.8 100.4 Z"/><path d="M89.5 81.1 Q100.5 89.1 115.1 83.0 Q101.6 74.8 89.5 81.1 Z"/><path d="M109.7 63.2 Q116.9 52.7 110.7 39.3 Q103.3 52.2 109.7 63.2 Z"/><path d="M131.1 46.7 Q139.5 55.2 152.8 51.5 Q142.3 42.6 131.1 46.7 Z"/><path d="M154.0 31.6 Q161.6 23.7 157.7 11.5 Q149.7 21.5 154.0 31.6 Z"/><path d="M178.2 18.0 Q184.1 26.2 195.8 24.5 Q188.1 15.6 178.2 18.0 Z"/><path d="M190.0 12.0 Q200.7 13.5 208.0 3.3 Q195.5 2.7 190.0 12.0 Z"/><path d="M71.0 100.1 Q81.0 122.1 106.2 114.5"/><path d="M22.6 166.6 L38.5 163.3 M37.3 143.1 L33.6 128.2 M53.4 121.1 L67.8 120.1 M70.8 100.4 L69.4 86.8 M89.5 81.1 L102.3 82.0 M109.7 63.2 L110.2 51.3 M131.1 46.7 L142.0 49.1 M154.0 31.6 L155.8 21.6 M178.2 18.0 L187.0 21.2 M190.0 12.0 L199.0 7.6" stroke-width=".8" opacity=".7"/></g><g fill="var(--inv-blush, #E8CFC4)" stroke="none"><circle cx="106.2" cy="114.5" r="4.2"/><circle cx="97.2" cy="110.5" r="3.2"/><circle cx="109.2" cy="104.5" r="3.0"/></g><g fill="var(--inv-blush, #E8CFC4)" stroke="currentColor" stroke-width=".9"><circle cx="101.4" cy="38.1" r="4.3"/><circle cx="107.4" cy="42.4" r="4.3"/><circle cx="105.1" cy="49.5" r="4.3"/><circle cx="97.7" cy="49.5" r="4.3"/><circle cx="95.4" cy="42.4" r="4.3"/><circle cx="101.4" cy="44.4" r="2.4" fill="currentColor"/></g></svg>
      {%- else -%}
        <svg class="inv-orn inv-orn--divider" viewBox="0 0 220 30" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
            <path d="M0 15h80M140 15h80"/>
            <path d="M110 15c-8-9-18-10-26-6 7 6 16 8 26 6Z"/>
            <path d="M110 15c8-9 18-10 26-6-7 6-16 8-26 6Z"/>
          </g>
          <circle cx="110" cy="15" r="3.2" fill="var(--inv-blush, #E8CFC4)" stroke="currentColor" stroke-width=".9"/>
        </svg>
    {%- endcase -%}

  {%- when 'sable' -%}
    {%- case part -%}
      {%- when 'crest' -%}
        <svg class="inv-orn inv-orn--crest" viewBox="0 0 220 118" aria-hidden="true" focusable="false">
          <path d="M70 110a40 40 0 0 1 80 0Z" fill="currentColor"/>
          <g fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M48 110a62 62 0 0 1 124 0"/>
            <path d="M26 110a84 84 0 0 1 168 0" opacity=".55"/>
            <path d="M4 110a106 106 0 0 1 212 0" opacity=".3"/>
            <path d="M0 110h220"/>
          </g>
        </svg>
      {%- when 'horizon' -%}
        <svg class="inv-orn inv-orn--horizon" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0 60C60 30 120 28 190 48s130 30 210-8V90H0Z" fill="currentColor" opacity=".16"/>
          <path d="M0 74C80 50 150 52 220 66s120 16 180-10V90H0Z" fill="currentColor" opacity=".26"/>
        </svg>
      {%- else -%}
        <svg class="inv-orn inv-orn--divider" viewBox="0 0 220 28" aria-hidden="true" focusable="false">
          <path d="M0 22h220" stroke="currentColor" stroke-width="1"/>
          <path d="M96 22a14 14 0 0 1 28 0Z" fill="currentColor"/>
          <path d="M88 22a22 22 0 0 1 44 0" fill="none" stroke="currentColor" stroke-width="1"/>
        </svg>
    {%- endcase -%}

  {%- else -%}
    {%- comment -%} Ivoire {%- endcomment -%}
    {%- case part -%}
      {%- when 'crest' -%}
        <svg class="inv-orn inv-orn--crest" viewBox="0 0 120 64" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round">
            <path d="M14 14v38h92V14"/><path d="M14 14l46 30 46-30"/>
          </g>
          <circle cx="60" cy="46" r="6.5" fill="currentColor"/>
        </svg>
      {%- else -%}
        <svg class="inv-orn inv-orn--divider" viewBox="0 0 220 20" aria-hidden="true" focusable="false">
          <path d="M0 10h94M126 10h94" stroke="currentColor" stroke-width="1"/>
          <circle cx="102" cy="10" r="1.6" fill="currentColor"/><circle cx="118" cy="10" r="1.6" fill="currentColor"/>
          <path d="M110 3l3.5 7-3.5 7-3.5-7z" fill="currentColor"/>
        </svg>
    {%- endcase -%}
{%- endcase -%}
