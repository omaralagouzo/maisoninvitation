{%- comment -%} Outputs `value`, converting 0-9 to Arabic-Indic numerals (٠-٩) when lang is 'ar'. {%- endcomment -%}
{%- if lang == 'ar' -%}
  {{- value | replace: '0', '٠' | replace: '1', '١' | replace: '2', '٢' | replace: '3', '٣' | replace: '4', '٤' | replace: '5', '٥' | replace: '6', '٦' | replace: '7', '٧' | replace: '8', '٨' | replace: '9', '٩' -}}
{%- else -%}
  {{- value -}}
{%- endif -%}
