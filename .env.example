# Store setup (npm run setup:store). Copy this file to .env (git-ignored) and fill it in.
# Step-by-step: tools/shopify-setup/README.md

# The store's .myshopify.com domain ("maison-invitation" on its own is enough).
SHOPIFY_STORE=maison-invitation.myshopify.com

# Option A (recommended): a Dev Dashboard app installed on the store (same Shopify organization).
# Dev Dashboard → your app → Settings → Client ID / Client secret. On every run the script swaps
# them for a 24-hour Admin API token (client credentials grant).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option B: an Admin API access token you already have. Used instead of A when set.
SHOPIFY_ADMIN_TOKEN=

# Optional: Admin API version. Defaults to 2026-07 (latest stable as of September 2026).
# SHOPIFY_API_VERSION=2026-07
